    "verify:agent-api": "npm run build && tsx scripts/verify-agent-api.ts",
    "eval:ripple": "tsx scripts/eval-ripple.ts --strict",
    "verify:growth": "tsx scripts/verify-growth.ts",
    "verify:host-runner": "tsx scripts/verify-host-runner.ts",
    "verify:extraction": "tsx scripts/verify-extraction-recovery.ts",
