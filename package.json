    "eval:embedding-profiles": "tsx scripts/eval-embedding-profiles.ts",
    "verify:release": "node scripts/verify-public-release.mjs",
    "verify:licenses": "node scripts/generate-license-notices.mjs --check",
    "eval:prepare-source": "tsx scripts/prepare-source-eval.ts",
    "mcp:http": "node dist/mcp-http.js serve",
    "verify:network-mcp": "tsx scripts/verify-network-mcp.ts"
  },
  "dependencies": {
