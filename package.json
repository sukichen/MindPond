    "verify:domain-migration": "tsx scripts/verify-domain-migration.ts",
    "verify:domain-synthesis": "tsx scripts/verify-domain-synthesis.ts",
    "verify:domain-entries": "tsx scripts/verify-domain-entries.ts",
    "verify:session-lifecycle": "tsx scripts/verify-session-lifecycle.ts",
    "verify:anchors": "tsx scripts/verify-anchors.ts",
    "verify:dimension-bridges": "tsx scripts/verify-dimension-bridges.ts",
    "verify:errors": "tsx scripts/verify-errors.ts",
    "verify:trusted-context": "tsx scripts/verify-trusted-context.ts",
    "verify:legacy-consolidation": "tsx scripts/verify-legacy-consolidation.ts",
    "verify:organize-request": "tsx scripts/verify-organization-request.ts",
