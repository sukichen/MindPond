# MindPond service configuration. Model execution and credentials stay in the host.
# MEMORY_DB_PATH=./data/graph.db
# MINDPOND_DATA_DIR=./data
# MEMORY_PORT=7903
# MEMORY_API_KEY=
# MEMORY_CONTEXT_SECRET=      # Signed host domains; missing tokens are rejected.
# MEMORY_OPERATOR_KEY=        # Separate human/operator capability.
# MEMORY_ALLOW_ANONYMOUS=1    # Explicit development compatibility; never a production default.
# MEMORY_ALLOW_UNAUTHENTICATED_NETWORK=1 # Development-only bypass of network API-key startup guard.
# EMBEDDING_MODEL_DIR=./models
# EMBEDDING_ZH_ENABLED=false
# MINDPOND_EMBEDDING_CONFIG=/absolute/path/embedding-profiles.json
# See docs/embedding-profiles.md. CPU/exact defaults; GPU/HNSW/rerank are opt-in.
# Models are local-only; building/activation never downloads weights.
# MCP identifies the native chat: bound role -> own/current offices;
# identified unbound chat -> human (all memories). Missing metadata is an error.
# Do not configure personal/session/operator/full-profile identity selectors.
# Human management uses the protected web workbench; see docs/role-memory.md.

# Optional browser credential issuance: same private grants file used by HTTP MCP gateway.
# Both processes must also share MEMORY_DB_PATH. Never put agent bearer tokens here.
# MINDPOND_MCP_ACCOUNTS=/private/mindpond/accounts.json

# Office waits: initial database-wide capacity (global >= per account).
# Saved Web administration policy takes precedence for all processes on this DB.
# MINDPOND_OFFICE_WAIT_PER_ACCOUNT=8
# MINDPOND_OFFICE_WAIT_GLOBAL=64

# Only behind a trusted reverse proxy on this same host; listener stays loopback.
# MEMORY_TRUST_PROXY=loopback

# Optional local inference: base installation does not install a model runtime.
# MINDPOND_EMBEDDING_MODE=text
# MINDPOND_LOCAL_INFERENCE_ROOT=/absolute/path/to/local-inference

# HTTP MCP transport sessions (Office + Memory each count separately).
# Independent from the database-wide office_wait capacity above.
# MINDPOND_MCP_MAX_CONNECTIONS=128
# MINDPOND_MCP_MAX_PER_ACCOUNT=64

# Generic collaboration artifacts; private runtime storage shared by DB processes.
# MINDPOND_ARTIFACT_DIR=/private/mindpond/artifacts
# MINDPOND_ARTIFACT_MAX_FILE_BYTES=67108864
# MINDPOND_ARTIFACT_MAX_TOTAL_BYTES=2147483648
# MINDPOND_ARTIFACT_RETENTION_SECONDS=2592000
# MINDPOND_ARTIFACT_MAX_RETENTION_SECONDS=31536000
